@{
    Model.Subject = "[司有雲ERP] 找回密碼驗證碼";
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Model.Subject</title>
</head>
<body>
    <p>尊敬的用戶：</p>
    <p>我們收到您找回密碼的請求，請使用下面的驗證碼繼續操作。<font color="#ff0000">如果不是您本人的操作，請直接忽略。</font></p>
    <p>
        您的驗證碼為：<strong style="font-size: 15pt;">@Model.Code</strong>，<strong>@Model.Action.Minutes</strong>分鐘內有效 - 請勿告知任何人。
    </p>
    <hr style="width: 100%; background: none; border: none; border-top: 1px solid #666; height: 1px; margin: 6px 0px;" />
    <table border="0" width="100%">
        <tr>
            <td valign="middle"><a href="https://www.etsoo.com/"><img src="https://cn.etsoo.com/etsoo.png" alt="ETSOO Logo" height="42" /></a></td>
            <td valign="middle" align="right"><small>億速思維 - 司友雲ERP<br />為中小企業技術賦能</small></td>
        </tr>
    </table>
</body>
</html>
