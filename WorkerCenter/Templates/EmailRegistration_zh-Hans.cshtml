@{
    Model.Subject = "[司有云ERP] 用户注册验证码";
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Model.Subject</title>
</head>
<body>
    <p>尊敬的用户：</p>
