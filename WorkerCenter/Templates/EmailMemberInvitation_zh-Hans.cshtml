@{
    Model.Subject = $"[司有云ERP] {Data.UserData.Name}的邀请";

    var url = Data.WebUrl + $"/invite/{Model.Id}?code={Model.Code}";
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Model.Subject</title>
</head>
<body>
    <p>您好！</p>
    <p><b>@Data.UserData.Name</b> 邀请您加入司有云ERP平台上的 <b>@Data.UserData.OrganizationName</b>。</p>
    @if (!string.IsNullOrWhiteSpace(Data.Message))
    {
        <p>留言：<q style="font-style:italic">@Data.Message</q></p>
    }
    <p><a href="@url">点击这里</a>打开程序，或者复制字符串 <pre>"@url"</pre> 在浏览器中访问，注册登陆后请接受邀请，<b>@Model.LocalExpiry.ToString("f")</b> 前有效。</p>
    <hr style="width: 100%; background: none; border: none; border-top: 1px solid #666; height: 1px; margin: 6px 0px;" />
    <table border="0" width="100%">
        <tr>
            <td valign="middle"><a href="https://www.etsoo.com/"><img src="https://cn.etsoo.com/etsoo.png" alt="ETSOO Logo" height="42" /></a></td>
            <td valign="middle" align="right"><small>亿速思维 - 司友云ERP<br />为中小企业技术赋能</small></td>
        </tr>
    </table>
</body>
</html>
