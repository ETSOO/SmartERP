# Base image, alpine is a lightweight linux distribution while scratch is an empty image
FROM ubuntu:latest

# Copy your source file directory into /app
# Why the path is "Resources/LocalSetup.sh", not "LocalSetup.sh", is because the path is relative to the "context" of the build
COPY Resources/LocalSetup.sh /app/LocalSetup.sh

# Copy the entrypoint script into the image
COPY Resources/LocalEntry.sh /app/LocalEntry.sh

# Change to /app
WORKDIR /app

# Container will run this command when it starts
# CMD ./LocalSetup.sh

# While RUN is executed during the build
RUN ./LocalSetup.sh

# This script will be executed when the container starts
ENTRYPOINT ["/app/LocalEntry.sh"]