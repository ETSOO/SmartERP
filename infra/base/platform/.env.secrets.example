# ==============================================================================
# SmartERP 生产环境配置模板 (.env.secrets.example)
# 说明: 提交至 Git 仓库作为参数清单，部署前请复制为 .env.secrets 并填入真实凭据
# 说明: .NET 将使用双下划线 (__) 自动将这里的环境变量覆盖内存中的 JSON 配置
# ==============================================================================

# ------------------------------------------------------------------------------
# 数据库与缓存连接串 (ConnectionStrings)
# ------------------------------------------------------------------------------
ConnectionStrings__SmartERP="Server=postgres-service;Port=5432;Userid=smarterp;Password=YOUR_PG_PASSWORD;Database=smarterp;Include Error Detail=false"
ConnectionStrings__SmartERPLog="Server=postgres-service;Port=5432;Userid=smarterp;Password=YOUR_PG_PASSWORD;Database=smarterp_log;Include Error Detail=false"
ConnectionStrings__SmartERPRedis="garnet-service:6379,password=YOUR_REDIS_PASSWORD,abortConnect=false"

# ------------------------------------------------------------------------------
# 核心业务与基础配置 (SmartERP:Configuration)
# ------------------------------------------------------------------------------
SmartERP__Configuration__PrivateKey="YOUR_SMARTERP_PRIVATE_KEY"
SmartERP__Configuration__WebUrl="https://smarterp.your-domain.com"
SmartERP__Configuration__ApiUrl="https://smarterp.your-domain.com/api"
SmartERP__Configuration__AuthFailureUrl="https://smarterp.your-domain.com/login/authfail"
SmartERP__Configuration__AuthRegistrationUrl="https://smarterp.your-domain.com/login/register"
SmartERP__Configuration__AuthSuccessUrl="https://smarterp.your-domain.com/login/authsuccess"
SmartERP__Configuration__CoreAppAuthApiUrl="https://smarterp.your-domain.com/api/Auth"
SmartERP__Configuration__SuperAdminOrganizationId=1099
SmartERP__Configuration__CacheHours=24
SmartERP__Configuration__RefreshTokenDays=30
SmartERP__Configuration__SimpleRegistration=true

# ------------------------------------------------------------------------------
# JWT 鉴权与加解密配置 (SmartERP:Jwt)
# ------------------------------------------------------------------------------
SmartERP__Jwt__DefaultIssuer="SmartERP"
SmartERP__Jwt__ValidateAudience=false
SmartERP__Jwt__AccessTokenMinutes=30
SmartERP__Jwt__EncryptionKey="YOUR_JWT_ENCRYPTION_KEY_32_CHARS"
# RSA 私钥/公钥 (建议压缩为单行或保持正确换行/Base64)
SmartERP__Jwt__PrivateKey="YOUR_RSA_PRIVATE_KEY_BASE64"
SmartERP__Jwt__PublicKey="YOUR_RSA_PUBLIC_KEY_BASE64"

# ------------------------------------------------------------------------------
# 存储配置 (SmartERP:Storage & StorageS3)
# ------------------------------------------------------------------------------
SmartERP__Storage__Root="/app/storage"
SmartERP__Storage__URLRoot="https://smarterp.your-domain.com/api/Storage"

SmartERP__StorageS3__Root="smarterp"
SmartERP__StorageS3__URLRoot="https://smarterp.your-domain.com/api/Storage"
SmartERP__StorageS3__Endpoint="http://minio-service.smarterp.svc.cluster.local:9000"
SmartERP__StorageS3__AccessKey="YOUR_MINIO_ACCESS_KEY"
SmartERP__StorageS3__SecretKey="YOUR_MINIO_SECRET_KEY"

# ------------------------------------------------------------------------------
# 第三方 OAuth 登录认证 (Wechat / Alipay / Google / Microsoft)
# ------------------------------------------------------------------------------
# 微信
WechatAuth__AppId="YOUR_WECHAT_APP_ID"
WechatAuth__AppSecret="YOUR_WECHAT_APP_SECRET"
WechatAuth__ServerRedirectUrl="https://smarterp.your-domain.com/api/OAuth2/Wechat"

# 支付宝
AlipayAuth__AppId="YOUR_ALIPAY_APP_ID"
AlipayAuth__RsaPrivateKey="YOUR_ALIPAY_RSA_PRIVATE_KEY"
AlipayAuth__RsaPublicKey="YOUR_ALIPAY_RSA_PUBLIC_KEY"
AlipayAuth__AppCertSN="YOUR_APP_CERT_SN"
AlipayAuth__AlipayCertSN="YOUR_ALIPAY_CERT_SN"
AlipayAuth__AlipayRootCertSN="YOUR_ALIPAY_ROOT_CERT_SN"
AlipayAuth__ServerRedirectUrl="https://smarterp.your-domain.com/api/OAuth2/Alipay"

# 谷歌
GoogleAuth__ClientId="YOUR_GOOGLE_CLIENT_ID"
GoogleAuth__ClientSecret="YOUR_GOOGLE_CLIENT_SECRET"
GoogleAuth__ServerRedirectUrl="https://smarterp.your-domain.com/api/OAuth2/Google"

# 微软
MicrosoftAuth__Authority="https://login.microsoftonline.com/common"
MicrosoftAuth__ClientId="YOUR_MICROSOFT_CLIENT_ID"
MicrosoftAuth__ClientSecret="YOUR_MICROSOFT_CLIENT_SECRET"
MicrosoftAuth__ServerRedirectUrl="https://smarterp.your-domain.com/api/OAuth2/Microsoft"

# ------------------------------------------------------------------------------
# OpenTelemetry 可观测性导出 (OtlpExportOptions / OpenObserve / Jaeger)
# ------------------------------------------------------------------------------
OtlpExportOptions__Protocol="HttpProtobuf"
OtlpExportOptions__Headers="Authorization=Basic YOUR_OPENOBSERVE_BASIC_AUTH_BASE64"
OtlpExportOptions__Logging__Endpoint="http://openobserve-service.smarterp.svc.cluster.local:5080/api/default/v1/logs"
OtlpExportOptions__Tracing__Endpoint="http://openobserve-service.smarterp.svc.cluster.local:5080/api/default/v1/traces"
OtlpExportOptions__Metrics__Endpoint="http://openobserve-service.smarterp.svc.cluster.local:5080/api/default/v1/metrics"

# ------------------------------------------------------------------------------
# 消息队列 (RabbitMQProducer)
# ------------------------------------------------------------------------------
RabbitMQProducer__HostName="rabbitmq-service.smarterp.svc.cluster.local"
RabbitMQProducer__Port=5672
RabbitMQProducer__QueueName="SmartERP"
RabbitMQProducer__Durable=true
RabbitMQProducer__UserName="YOUR_RABBITMQ_USER"
RabbitMQProducer__Password="YOUR_RABBITMQ_PASSWORD"

# ------------------------------------------------------------------------------
# 限流配置 (RateLimiters)
# ------------------------------------------------------------------------------
RateLimiters__Global__AnonymousLimit=-1
RateLimiters__Global__DeleteLimit=10
RateLimiters__Global__PermitLimit=100
RateLimiters__PII__AnonymousLimit=0
RateLimiters__PII__PermitLimit=50
RateLimiters__PII__QueueLimit=0