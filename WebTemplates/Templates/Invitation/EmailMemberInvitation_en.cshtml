@model PlatformShared.Dto.InvitationAuthCodeEmailTemplateView

@{
    Model.Subject = $"[SmartERP] Invitation from {Model.DataObj.UserData.Name}";

    var url = Model.DataObj.WebUrl + $"/invite/{Model.Id}?code={Model.Code}";
}
<!DOCTYPE html>

<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Model.Subject</title>
</head>
<body>
    <p>Hi there,</p>
    <p><b>@Model.DataObj.UserData.Name</b> invites you to join <b>@Model.DataObj.UserData.OrganizationName</b> on SmartERP platform, valid before <b>@Model.LocalExpiry.ToString("f")</b>. Please accept the invitation after registering and logging in.</p>
    @if (!string.IsNullOrWhiteSpace(Model.DataObj.Message))
    {
        <p>Message: <q style="font-style:italic">@Model.DataObj.Message</q></p>
    }
    <p><a href="@url">Click here</a> to open the program, or copy the string <pre>"@url"</pre> to access in the browser.</p>
    <hr style="width: 100%; background: none; border: none; border-top: 1px solid #666; height: 1px; margin: 6px 0px;" />
    <table border="0" width="100%">
        <tr>
            <td valign="middle"><a href="https://www.etsoo.com/"><img src="https://cn.etsoo.com/etsoo.png" alt="ETSOO Logo" height="42" /></a></td>
            <td valign="middle" align="right"><small>ETSOO - SmartERP<br /><b>E</b>mpowering <b>T</b>echnology for <b>S</b>MEs</small></td>
        </tr>
    </table>
</body>
</html>
