@model PlatformShared.Dto.InvitationAuthCodeEmailTemplateView

@{
    Model.Subject = $"[司有雲ERP] {Model.DataObj.UserData.Name}的邀請";

    var url = Model.DataObj.WebUrl + $"/invite/{Model.Id}?code={Model.Code}";
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Model.Subject</title>
</head>
<body>
    <p>您好！</p>
    <p><b>@Model.DataObj.UserData.Name</b> 邀請您加入司有雲ERP平台上的 <b>@Model.DataObj.UserData.OrganizationName</b>。</p>
    @if (!string.IsNullOrWhiteSpace(Model.DataObj.Message))
    {
        <p>留言：<q style="font-style:italic">@Model.DataObj.Message</q></p>
    }
    <p><a href="@url">點這裡</a>打開程序，或者複製字串 <pre>"@url"</pre> 在瀏覽器中訪問，註冊登陸後請接受邀請，<b>@Model.LocalExpiry.ToString("f")</b> 前有效。</p>
    <hr style="width: 100%; background: none; border: none; border-top: 1px solid #666; height: 1px; margin: 6px 0px;" />
    <table border="0" width="100%">
        <tr>
            <td valign="middle"><a href="https://www.etsoo.com/"><img src="https://cn.etsoo.com/etsoo.png" alt="ETSOO Logo" height="42" /></a></td>
            <td valign="middle" align="right"><small>億速思維 - 司友雲ERP<br />為中小企業技術賦能</small></td>
        </tr>
    </table>
</body>
</html>
