@model PlatformShared.Dto.AuthCodeEmailTemplateView

@{
    Model.Subject = "[SmartERP] Retrieving Password Code";
}
<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@Model.Subject</title>
</head>
<body>
    <p>Dear user,</p>
    <p>We received your request to retrieve your password, please use the code below to continue. <font color="#ff0000">If it is not your own operation, please ignore it.</font></p>
    <p>
        Your verification code is: <strong style="font-size: larger">@Model.Code</strong> and effective within <strong>@Model.Action.Minutes</strong> minutes. Do not share it with anyone.
    </p>
    <hr style="width: 100%; background: none; border: none; border-top: 1px solid #666; height: 1px; margin: 6px 0px;" />
    <table border="0" width="100%">
        <tr>
            <td valign="middle"><a href="https://etsoo.com/" target="_blank"><img src="https://etsoo.com/images/etsoo.png" alt="ETSOO Logo" height="42" /></a></td>
            <td valign="middle" align="right"><small>ETSOO - SmartERP<br /><b>E</b>mpowering <b>T</b>echnology for <b>S</b>MEs</small></td>
        </tr>
    </table>
</body>
</html>